# REQUIRED — the API key sent as `X-API-KEY` on every backend call. Must equal the
# backend's own AI_API_KEY, or every request comes back 401. One value per environment
# (dev and production hold different keys). The `VITE_` prefix is mandatory: Vite only
# exposes prefixed variables to client code, so naming it plain `AI_API_KEY` here would
# read as undefined at runtime with no build error to warn you.
# NOTE: like the account creds below, this is inlined into the built JS bundle — anyone
# who opens devtools can read it. It keeps strangers and scripts out of endpoints that
# spend money per call; it is NOT per-user authorization.
VITE_AI_API_KEY=your_backend_ai_api_key

# URL the BACKEND will POST webhooks to. The backend opens this URL
# directly (server-to-server), so it bypasses the Vite proxy — use the
# raw relay URL, not `/relay/...`. Default = local relay service.
VITE_WEBHOOK_URL=http://localhost:3100/receiver

# Liberate ad-account gate (client-side only). The setup form verifies the
# entered ad-account id + token against these; on a match it sends only
# VITE_LIBERATE_TENANT_ID to the backend. The creds never leave the browser.
# NOTE: these are inlined into the built JS bundle — a soft UI gate, not a secret.
VITE_LIBERATE_AAID=your_meta_ad_account_id
VITE_LIBERATE_TOKEN=your_meta_graph_api_access_token
VITE_LIBERATE_TENANT_ID=your_tenant_uuid
